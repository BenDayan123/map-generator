<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GmapPlanner.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="720"
        x:Class="GmapPlanner.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/avalonia-logo.ico"
        Width="1020" Height="720" MinWidth="900" MinHeight="620"
        Title="My Maps Generator">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.sideHeader">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.metricLabel">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.metricValue">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Sidebar nav entries: flat, full width, left aligned -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#33808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Styles>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- Sidebar: drag the splitter to resize. MaxWidth is pinned to 1/3 of the
                 window in code-behind (OnSizeChanged). -->
            <ColumnDefinition Width="280" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ SIDEBAR ============================ -->
        <!-- Padding is 0 so the scrollbar sits flush against the right edge; the inner
             content carries its own margin, with extra room on the right as the scrollbar
             gutter so the bar never overlaps the controls. -->
        <Border Grid.Column="0" Background="#14808080">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6" Margin="16,16,14,16">
                    <TextBlock Text="🗺️ My Maps Generator" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />

                    <Button Classes="nav" Content="🗺️  Make Map" Command="{Binding ShowMakeMapCommand}" />
                    <Button Classes="nav" Content="⚙️  Settings" Command="{Binding ShowSettingsCommand}" />

                    <Separator Margin="0,12" />

                    <!-- Geocoding usage ring (hidden until a service account is configured).
                         Canvas so the track ellipse and progress arc share one absolute
                         140×140 coordinate space (a laid-out Path would auto-center and drift). -->
                    <StackPanel IsVisible="{Binding HasUsage}" Spacing="4">
                        <TextBlock Classes="sideHeader" Text="API usage" />
                        <Grid Width="140" Height="140" HorizontalAlignment="Center">
                            <Canvas Width="140" Height="140">
                                <Ellipse Canvas.Left="16" Canvas.Top="16" Width="108" Height="108"
                                         Stroke="#33808080" StrokeThickness="12" />
                                <Path Stretch="None" Stroke="{Binding UsageColor}" StrokeThickness="12"
                                      StrokeLineCap="Round" Data="{Binding UsageRingGeometry}" />
                            </Canvas>
                            <TextBlock Text="{Binding UsagePercentText}" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Classes="caption" Text="{Binding UsageSubText}"
                                   TextAlignment="Center" HorizontalAlignment="Center" />
                        <Separator Margin="0,12" />
                    </StackPanel>

                    <TextBlock Classes="sideHeader" Text="Options" />

                    <TextBlock Text="Days per KML file" FontSize="13" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0" Minimum="1" Maximum="{Binding MaxLayersPerFile}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding LayersPerFile}" />
                        <TextBlock Grid.Column="1" Text="{Binding LayersPerFile}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Classes="caption"
                               Text="Google My Maps allows at most 10 layers (days) per map." />

                    <ToggleSwitch Margin="0,10,0,0" IsChecked="{Binding SkipGeocoding}"
                                  OnContent="Skip geocoding" OffContent="Skip geocoding" />
                    <TextBlock Classes="caption"
                               Text="Use Gemini's approximate coordinates instead of snapping each place to its exact Google Maps point. Faster, less accurate pins." />

                    <Separator Margin="0,12" />

                    <TextBlock Classes="sideHeader" Text="Publish to My Maps" />
                    <TextBlock Classes="caption"
                               Text="Creates a live Google My Maps map per file and shares it — drives a browser on this machine." />

                    <ToggleSwitch Margin="0,8,0,0" IsChecked="{Binding PublishEnabled}"
                                  OnContent="Create &amp; share maps" OffContent="Create &amp; share maps" />

                    <StackPanel Spacing="8" IsVisible="{Binding PublishEnabled}">
                        <Button Content="🔐 Log in to Google" HorizontalAlignment="Stretch"
                                Command="{Binding LogInToGoogleCommand}" IsEnabled="{Binding !IsLoggingIn}" />
                        <Button Content="Check status" HorizontalAlignment="Stretch"
                                Command="{Binding CheckLoginCommand}" IsEnabled="{Binding !IsLoggingIn}" />
                        <TextBlock Classes="caption" Text="{Binding LoginStatus}"
                                   IsVisible="{Binding LoginStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <TextBlock Text="Share with (emails)" FontSize="13" Margin="0,4,0,0" />
                        <TextBox Text="{Binding ShareEmails}" AcceptsReturn="True" Height="60"
                                 Watermark="alice@example.com, bob@example.com" />
                        <TextBlock Classes="caption"
                                   Text="Comma or line separated. Leave empty to create the maps without sharing." />

                        <TextBlock Text="Their access" FontSize="13" Margin="0,4,0,0" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ShareRoles}"
                                  SelectedIndex="{Binding ShareRoleIndex}" />

                        <ToggleSwitch IsChecked="{Binding NotifyShare}"
                                      OnContent="Email people when shared" OffContent="Email people when shared" />
                        <ToggleSwitch IsChecked="{Binding ShowBrowser}"
                                      OnContent="Show the browser" OffContent="Show the browser" />
                        <TextBlock Classes="caption"
                                   Text="Headless by default. Turn on to watch or debug the automation." />
                        <TextBlock Classes="caption"
                                   Text="Sharing needs a Drive OAuth desktop client saved as credentials.json in the app data folder. Every map also gets download, print and copy turned off for viewers." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Drag to resize the sidebar (clamped to 1/3 of the window in code-behind).
             8px wide so it's easy to grab; a resize cursor signals it's draggable. -->
        <GridSplitter Grid.Column="1" Width="8" Background="#22808080"
                      ResizeDirection="Columns" HorizontalAlignment="Stretch"
                      Cursor="SizeWestEast" />

        <!-- ============================== MAIN ============================== -->
        <ScrollViewer Grid.Column="2">
            <Grid Margin="32,28">

                <!-- ======================== MAKE MAP ======================== -->
                <StackPanel Spacing="16" IsVisible="{Binding IsMakeMapPage}">
                    <TextBlock Classes="h1" Text="🗺️ My Maps Generator" />
                    <TextBlock Classes="caption"
                               Text="Upload a travel itinerary (PDF or TXT) and get Google My Maps KML files — each day a colored layer with numbered pins." />

                    <!-- Drop zone -->
                    <Border Name="DropZone" Classes="card" MinHeight="130"
                            BorderThickness="2" Background="#0A808080">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="📄" FontSize="30" HorizontalAlignment="Center" />
                            <TextBlock Text="Drag &amp; drop your itinerary here"
                                       HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Classes="caption" HorizontalAlignment="Center"
                                       Text="One PDF or TXT file at a time, up to 15 MB." />
                            <Button Name="BrowseInputButton" Content="Browse files"
                                    HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding InputFileName}" HorizontalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#388E3C"
                                       IsVisible="{Binding InputFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>

                    <Button Content="Generate map files" Classes="accent"
                            Command="{Binding GenerateCommand}" HorizontalAlignment="Left"
                            Padding="18,10" FontWeight="SemiBold" />

                    <!-- Progress -->
                    <Border Classes="card" IsVisible="{Binding IsBusy}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
                        </StackPanel>
                    </Border>

                    <!-- Error -->
                    <Border Classes="card" BorderBrush="#D32F2F" Background="#18D32F2F"
                            IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#EF5350" />
                    </Border>

                    <!-- Results -->
                    <StackPanel Spacing="16" IsVisible="{Binding HasResult}">
                        <Border Classes="card" BorderBrush="#388E3C" Background="#18388E3C">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="✅ Created" />
                                <Run Text="{Binding ResultFiles.Count}" FontWeight="Bold" />
                                <Run Text="KML file(s) for" />
                                <Run Text="{Binding ResultTripName}" FontWeight="Bold" />
                            </TextBlock>
                        </Border>

                        <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,4">
                            <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Classes="metricLabel" Text="Days" />
                                    <TextBlock Classes="metricValue" Text="{Binding ResultDays}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="card" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Classes="metricLabel" Text="Locations" />
                                    <TextBlock Classes="metricValue" Text="{Binding ResultLocations}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="card" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Classes="metricLabel" Text="Exact coords" />
                                    <TextBlock Classes="metricValue" Text="{Binding ResultExactCoords}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Geocoding warning: e.g. billing not enabled, or no Geo key. -->
                        <Border Classes="card" BorderBrush="#F9A825" Background="#18F9A825"
                                IsVisible="{Binding GeocodeWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock TextWrapping="Wrap" Foreground="#F9A825">
                                <Run Text="⚠️ Coordinates kept from Gemini — geocoding did not run." FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="{Binding GeocodeWarning}" />
                            </TextBlock>
                        </Border>

                        <TextBlock Text="Files" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Classes="caption" Text="{Binding ResultOutputDir}" />
                        <Button Content="📂 Open output folder" Classes="accent"
                                Command="{Binding OpenOutputFolderCommand}"
                                HorizontalAlignment="Stretch" Padding="14,10" />

                        <ItemsControl ItemsSource="{Binding ResultFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KmlFileItem">
                                    <Border Classes="card" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="🗺️" />
                                                    <Run Text="{Binding DayLabel}" />
                                                </TextBlock>
                                                <TextBlock Classes="caption">
                                                    <Run Text="{Binding FileName}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding SizeText}" />
                                                </TextBlock>
                                                <TextBlock Classes="caption" Text="{Binding SharedWith}"
                                                           IsVisible="{Binding SharedWith, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Classes="caption" Foreground="#EF5350" TextWrapping="Wrap"
                                                           IsVisible="{Binding MapError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <Run Text="⚠️ Map not created:" />
                                                    <Run Text="{Binding MapError}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🌍 Open map" VerticalAlignment="Center"
                                                    IsVisible="{Binding HasMap}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenMapCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Header="How to import into Google My Maps">
                            <TextBlock TextWrapping="Wrap" Margin="0,6" LineHeight="22"
                                       Text="1. Open Google My Maps (google.com/mymaps) → Create a new map.&#10;2. Click Import under a layer and upload one KML file.&#10;3. Each KML adds up to 10 day-layers. For longer trips, import each file into its own layer/map." />
                        </Expander>
                    </StackPanel>
                </StackPanel>

                <!-- ======================== SETTINGS ======================== -->
                <StackPanel Spacing="16" IsVisible="{Binding IsSettingsPage}">
                    <TextBlock Classes="h1" Text="⚙️ Settings" />
                    <TextBlock Classes="caption"
                               Text="Saved on this computer, so you only enter them once." />

                    <!-- One-file setup -->
                    <Border Classes="card" BorderBrush="#0288D1" Background="#140288D1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="📦 One-file setup" FontWeight="SemiBold" />
                            <TextBlock Classes="caption"
                                       Text="Drop a single JSON to fill in every setting below — API keys, the service-account JSON, and the Drive credentials.json (written automatically). Any key not in the file keeps its current value." />
                            <Button Name="SetupBundleButton" Content="Choose setup file…"
                                    HorizontalAlignment="Left" />
                            <TextBlock Classes="caption" Text="{Binding SetupMessage}" Foreground="#388E3C"
                                       IsVisible="{Binding SetupMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Gemini API key" FontWeight="SemiBold" />
                            <TextBlock Classes="caption"
                                       Text="Used to read the itinerary and extract every place per day." />
                            <TextBox PasswordChar="•" Text="{Binding GoogleApiKey}"
                                     Watermark="AIza…" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Geocoding API key" FontWeight="SemiBold" />
                            <TextBlock Classes="caption"
                                       Text="Snaps each place name to its exact Google Maps coordinates. Without it, Gemini's rougher coordinates are used." />
                            <TextBox PasswordChar="•" Text="{Binding GeoApiKey}"
                                     Watermark="AIza…" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Output folder" FontWeight="SemiBold" />
                            <TextBlock Classes="caption"
                                       Text="Each trip's KML files are written to a subfolder named after the trip." />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding OutputDir}" />
                                <Button Grid.Column="1" Name="BrowseOutputButton" Content="Browse…"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Service-account JSON (usage gauge) -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Usage gauge (optional)" FontWeight="SemiBold" />
                            <TextBlock Classes="caption"
                                       Text="Paste the service-account JSON to show the live Geocoding-usage ring — the project is read from it. Needs the Cloud Monitoring API enabled and a service account with roles/monitoring.viewer." />
                            <TextBox AcceptsReturn="True" Height="90" TextWrapping="Wrap"
                                     Text="{Binding GcpSaJson}"
                                     Watermark="Paste the whole service-account .json here" />
                        </StackPanel>
                    </Border>

                    <!-- Drive sharing credentials -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Drive sharing credentials (optional)" FontWeight="SemiBold" />
                            <TextBlock Classes="caption"
                                       Text="Needed only to share maps. An OAuth Desktop client credentials.json (Drive API enabled), saved locally; a browser consent runs once on first share." />
                            <Button Name="CredentialsButton" Content="Choose credentials.json…"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Setup status -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Setup status" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock>
                                <Run Text="{Binding HasGeminiKey, Converter={x:Static vm:BoolTick.Instance}}" />
                                <Run Text="Gemini API key" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{Binding HasGeoKey, Converter={x:Static vm:BoolTick.Instance}}" />
                                <Run Text="Geocoding API key" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{Binding HasGoogleLogin, Converter={x:Static vm:BoolTick.Instance}}" />
                                <Run Text="Signed in to Google (My Maps)" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{Binding HasDriveCredentials, Converter={x:Static vm:BoolTick.Instance}}" />
                                <Run Text="Drive credentials.json" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{Binding HasDriveToken, Converter={x:Static vm:BoolTick.Instance}}" />
                                <Run Text="Drive access authorized" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

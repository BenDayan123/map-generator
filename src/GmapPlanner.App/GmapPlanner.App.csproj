<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- App version. The updater reads this; CI stamps the release tag over it with
         -p:Version=x.y.z at publish time, so a tag and the built binary always agree. -->
    <Version>1.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
    <!-- Single-file on Windows only. On macOS every native dylib must sit on disk inside
         the .app so codesign can sign it (a single-file bundle extracts its dylibs at runtime,
         outside the signed bundle) — see build/make-macos-dmg.sh. -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != 'osx-arm64'">true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != 'osx-arm64'">true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- PublishTrimmed turns reflection-based System.Text.Json OFF for the whole app.
         Our own code goes through the source-generated GmapPlannerJsonContext, but
         Microsoft.Playwright serializes its driver protocol with reflection-based STJ
         internally — with the switch off, opening a browser (e.g. Google login) throws
         "Reflection-based serialization has been disabled". Turn it back on; Playwright
         is a TrimmerRootAssembly, so the types it reflects over survive trimming. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- ILLink strips method parameter names by default. Playwright's reflection STJ binds
         constructor parameters by name (e.g. KeyValuePair<string,string>(key, value)), so
         without them "Sign in to Google" fails in the published app only: "The deserialization
         constructor for type 'KeyValuePair`2…' contains parameters with null names". -->
    <_ExtraTrimmerArgs>$(_ExtraTrimmerArgs) --keep-metadata parametername</_ExtraTrimmerArgs>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Pin Playwright's node driver to the TARGET rid. Left to itself, the targets fall
         back to the build-host OS when the RID is set but they don't recognize it, so a
         win-x64 driver could ride along in the osx-arm64 publish. Mapping each RID to its
         platform keeps the bundle to the one driver that can actually run. With no RID
         (a dev `dotnet run`) the property stays empty and the targets pick the host
         driver, which is what a local run wants. -->
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">osx-arm64</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">win</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- All of these serialize or bind via reflection, so the trimmer can silently
         strip members they need at runtime — a failure that never shows up in a
         Debug run. Keeping the assemblies whole costs a few MB against a broken
         KML file, a dead Drive call, or a browser session that won't start. -->
    <TrimmerRootAssembly Include="SharpKml.Core" />
    <TrimmerRootAssembly Include="Google.Apis" />
    <TrimmerRootAssembly Include="Google.Apis.Core" />
    <TrimmerRootAssembly Include="Google.Apis.Auth" />
    <TrimmerRootAssembly Include="Google.Apis.Drive.v3" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <TrimmerRootAssembly Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GmapPlanner.UI\GmapPlanner.UI.csproj" />
    <ProjectReference Include="..\GmapPlanner.Core.Publish\GmapPlanner.Core.Publish.csproj" />
  </ItemGroup>

  <!-- Single-file publish strips Playwright's node/<platform> driver from the loose
       publish dir (it's a native exe the bundler swallows), but Playwright must exec it
       as a real file on disk. The build output already holds the RID-correct driver
       (via PlaywrightPlatform above), so copy it back next to the single-file exe after
       publish. On a non-Windows build host, restore the +x bit the copy drops. -->
  <Target Name="RestorePlaywrightNodeDriver" AfterTargets="Publish"
          Condition="'$(PublishSingleFile)' == 'true' AND '$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_PlaywrightNodeFiles Include="$(OutputPath).playwright\node\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_PlaywrightNodeFiles)"
          DestinationFiles="@(_PlaywrightNodeFiles-&gt;'$(PublishDir).playwright\node\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="chmod +x &quot;$(PublishDir).playwright/node/&quot;*/node" />
  </Target>
</Project>

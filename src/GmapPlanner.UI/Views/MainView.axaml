<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GmapPlanner.App.ViewModels"
             xmlns:sys="using:System"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="720"
             x:Class="GmapPlanner.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True"
             Background="{StaticResource BgBrush}"
             FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
             FontSize="14">
    <!-- The whole app UI, host-agnostic: the desktop MainWindow wraps it today, the
         browser host (phase 2) uses it as its single view. -->

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- All styles/tokens live in App.axaml so the whole app shares one design system. -->

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- Sidebar: drag the splitter to resize. MaxWidth is pinned to 1/3 of the
                 window in code-behind (OnSizeChanged). -->
            <ColumnDefinition Width="280" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ SIDEBAR ============================ -->
        <!-- Padding is 0 so the scrollbar sits flush against the right edge; the inner
             content carries its own margin, with extra room on the right as the scrollbar
             gutter so the bar never overlaps the controls. -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6" Margin="16,18,14,18">
                    <Button Classes="nav" Command="{Binding ShowMakeMapCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="icon" Width="17" Height="17" VerticalAlignment="Center" Data="{StaticResource IconPin}" />
                            <TextBlock Text="Make Map" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Command="{Binding ShowAnalyticsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="icon" Width="17" Height="17" VerticalAlignment="Center" Data="{StaticResource IconChart}" />
                            <TextBlock Text="Analytics" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Command="{Binding ShowSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="icon" Width="17" Height="17" VerticalAlignment="Center" Data="{StaticResource IconSettings}" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,14" Background="{StaticResource HairlineBrush}" />

                    <!-- Places API usage ring (hidden until a service account is configured).
                         Canvas so the track ellipse and progress arc share one absolute
                         140×140 coordinate space (a laid-out Path would auto-center and drift). -->
                    <StackPanel IsVisible="{Binding HasUsage}" Spacing="4">
                        <TextBlock Classes="sideHeader" Text="API USAGE" />
                        <Grid Width="140" Height="140" HorizontalAlignment="Center">
                            <Canvas Width="140" Height="140">
                                <!-- Width/Top sized so Avalonia's half-stroke deflation lands the
                                     track's centerline on radius 54 (Center 70) — the same circle
                                     the arc path uses — so the progress arc aligns with the track. -->
                                <Ellipse Canvas.Left="10" Canvas.Top="10" Width="120" Height="120"
                                         Stroke="{StaticResource HairlineBrush}" StrokeThickness="12" />
                                <Path Stretch="None" Stroke="{Binding UsageColor}" StrokeThickness="12"
                                      StrokeLineCap="Round" Data="{Binding UsageRingGeometry}" />
                            </Canvas>
                            <TextBlock Text="{Binding UsagePercentText}" FontSize="24" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Classes="caption" Text="{Binding UsageSubText}"
                                   TextAlignment="Center" HorizontalAlignment="Center" />
                        <Separator Margin="0,14" Background="{StaticResource HairlineBrush}" />
                    </StackPanel>

                    <TextBlock Classes="sideHeader" Text="OPTIONS" />

                    <TextBlock Text="Days per KML file" FontSize="13" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0" Minimum="1" Maximum="{Binding MaxLayersPerFile}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding LayersPerFile}" />
                        <TextBlock Grid.Column="1" Text="{Binding LayersPerFile}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Classes="caption"
                               Text="Google My Maps allows at most 10 layers (days) per map." />

                    <ToggleSwitch Margin="0,10,0,0" IsChecked="{Binding SkipGeocoding}"
                                  OnContent="Skip geocoding" OffContent="Skip geocoding" />
                    <TextBlock Classes="caption"
                               Text="Use Gemini's approximate coordinates instead of snapping each place to its exact Google Maps point. Faster, less accurate pins." />

                    <Separator Margin="0,14" Background="{StaticResource HairlineBrush}" />

                    <TextBlock Classes="sideHeader" Text="PUBLISH TO MY MAPS" />
                    <TextBlock Classes="caption"
                               Text="Creates a live Google My Maps map per file and shares it — drives a browser on this machine." />

                    <ToggleSwitch Margin="0,8,0,0" IsChecked="{Binding PublishEnabled}"
                                  OnContent="Create &amp; share maps" OffContent="Create &amp; share maps" />

                    <StackPanel Spacing="8" IsVisible="{Binding PublishEnabled}">
                        <Button HorizontalAlignment="Stretch"
                                Command="{Binding LogInToGoogleCommand}" IsEnabled="{Binding !IsLoggingIn}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Width="15" Height="15" VerticalAlignment="Center" Data="{StaticResource IconLock}" />
                                <TextBlock Text="Log in to Google" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Check status" HorizontalAlignment="Stretch"
                                Command="{Binding CheckLoginCommand}" IsEnabled="{Binding !IsLoggingIn}" />
                        <TextBlock Classes="caption" Text="{Binding LoginStatus}"
                                   IsVisible="{Binding LoginStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <TextBlock Text="Share with (emails)" FontSize="13" Margin="0,4,0,0" />
                        <Border Classes="tokenBox">
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding ShareEmailsList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <Border Classes="chip">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                    <Button Classes="chipClose" Content="✕"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveEmailCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Name="EmailEntry" Classes="tokenEntry"
                                         Watermark="add more people …" />
                            </WrapPanel>
                        </Border>
                        <TextBlock Classes="caption"
                                   Text="Type an email and press Enter. Leave empty to create the maps without sharing." />

                        <TextBlock Text="Their access" FontSize="13" Margin="0,4,0,0" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ShareRoles}"
                                  SelectedIndex="{Binding ShareRoleIndex}" />

                        <ToggleSwitch IsChecked="{Binding NotifyShare}"
                                      OnContent="Email people when shared" OffContent="Email people when shared" />
                        <ToggleSwitch IsChecked="{Binding ShowBrowser}"
                                      OnContent="Show the browser" OffContent="Show the browser" />
                        <TextBlock Classes="caption"
                                   Text="Headless by default. Turn on to watch or debug the automation." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Drag to resize the sidebar (clamped to 1/3 of the window in code-behind).
             8px wide so it's easy to grab; a resize cursor signals it's draggable. -->
        <GridSplitter Grid.Column="1" Width="8" Background="{StaticResource HairlineBrush}"
                      ResizeDirection="Columns" HorizontalAlignment="Stretch"
                      Cursor="SizeWestEast" />

        <!-- ============================== MAIN ============================== -->
        <ScrollViewer Grid.Column="2">
            <Grid Margin="32,28">

                <!-- ======================== MAKE MAP ======================== -->
                <StackPanel Spacing="18" IsVisible="{Binding IsMakeMapPage}">
                    <StackPanel Orientation="Horizontal" Spacing="11">
                        <Path Classes="icon" Width="26" Height="26" VerticalAlignment="Center"
                              StrokeThickness="1.6" Stroke="#3B82F6" Data="{StaticResource IconPin}" />
                        <TextBlock Classes="h1" Text="My Maps Generator" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" FontSize="13.5"
                               Text="Upload a travel itinerary (PDF or TXT) and get Google My Maps KML files — each day a colored layer with numbered pins." />

                    <!-- Drop zone -->
                    <Border Name="DropZone" Classes="card" MinHeight="150"
                            BorderThickness="1.5" BorderBrush="#2E4370" Background="#101A2E">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                            <Path Classes="icon" Width="38" Height="38" HorizontalAlignment="Center"
                                  Stroke="{StaticResource TextSecondaryBrush}" Data="{StaticResource IconFile}" />
                            <TextBlock Text="Drag &amp; drop your itinerary here"
                                       HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Classes="caption" HorizontalAlignment="Center"
                                       Text="One PDF or TXT file at a time, up to 15 MB." />
                            <Button Name="BrowseInputButton" Content="Browse files"
                                    HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding InputFileName}" HorizontalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                                       IsVisible="{Binding InputFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>

                    <Button Classes="accent" Command="{Binding GenerateCommand}"
                            HorizontalAlignment="Left" Padding="18,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="16" Height="16" VerticalAlignment="Center" Stroke="#FFFFFF" Data="{StaticResource IconUpload}" />
                            <TextBlock Text="Generate map files" VerticalAlignment="Center" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>

                    <!-- Progress -->
                    <Border Classes="card" IsVisible="{Binding IsBusy}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
                        </StackPanel>
                    </Border>

                    <!-- Error -->
                    <Border Classes="card" BorderBrush="{StaticResource DangerBrush}" Background="#1FEF4444"
                            IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
                    </Border>

                    <!-- Results -->
                    <StackPanel Spacing="16" IsVisible="{Binding HasResult}">
                        <Border Classes="card" BorderBrush="{StaticResource SuccessBrush}" Background="#1F22C55E">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Created" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                <Run Text="{Binding ResultFiles.Count}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" />
                                <Run Text="KML file(s) for" Foreground="{StaticResource SuccessBrush}" />
                                <Run Text="{Binding ResultTripName}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" />
                            </TextBlock>
                        </Border>

                        <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,4">
                            <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Classes="metricLabel" Text="DAYS" />
                                    <TextBlock Classes="metricValue" Text="{Binding ResultDays}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="card" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Classes="metricLabel" Text="LOCATIONS" />
                                    <TextBlock Classes="metricValue" Text="{Binding ResultLocations}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="card" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Classes="metricLabel" Text="EXACT COORDS" />
                                    <TextBlock Classes="metricValue" Text="{Binding ResultExactCoords}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Geocoding warning: e.g. Places API not enabled, or no Places key. -->
                        <Border Classes="card" BorderBrush="{StaticResource WarnBrush}" Background="#1FF59E0B"
                                IsVisible="{Binding GeocodeWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}">
                                <Run Text="Coordinates kept from Gemini — geocoding did not run." FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="{Binding GeocodeWarning}" />
                            </TextBlock>
                        </Border>

                        <TextBlock Classes="sideHeader" Text="FILES" Margin="0,4,0,0" />
                        <TextBlock Classes="caption"
                                   Text="Not saved to disk — download the KML files to a folder of your choice." />
                        <Button Name="DownloadButton" Classes="accent"
                                HorizontalAlignment="Stretch" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Path Classes="icon" Width="16" Height="16" VerticalAlignment="Center" Stroke="#FFFFFF" Data="{StaticResource IconDownload}" />
                                <TextBlock Text="Download KML files" VerticalAlignment="Center" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>

                        <ItemsControl ItemsSource="{Binding ResultFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KmlFileItem">
                                    <Border Classes="card" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Path Classes="icon" Width="14" Height="14" VerticalAlignment="Center" Data="{StaticResource IconPin}" />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DayLabel}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Classes="caption">
                                                    <Run Text="{Binding FileName}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding SizeText}" />
                                                </TextBlock>
                                                <TextBlock Classes="caption" Text="{Binding SharedWith}"
                                                           IsVisible="{Binding SharedWith, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Classes="caption" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                                           IsVisible="{Binding MapError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <Run Text="Map not created:" FontWeight="SemiBold" />
                                                    <Run Text="{Binding MapError}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center"
                                                    IsVisible="{Binding HasMap}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenMapCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Path Classes="icon" Width="15" Height="15" VerticalAlignment="Center" Data="{StaticResource IconGlobe}" />
                                                    <TextBlock Text="Open map" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Header="How to import into Google My Maps">
                            <TextBlock TextWrapping="Wrap" Margin="0,6" LineHeight="22"
                                       Text="1. Open Google My Maps (google.com/mymaps) → Create a new map.&#10;2. Click Import under a layer and upload one KML file.&#10;3. Each KML adds up to 10 day-layers. For longer trips, import each file into its own layer/map." />
                        </Expander>
                    </StackPanel>
                </StackPanel>

                <!-- ======================== ANALYTICS ======================== -->
                <StackPanel Spacing="18" IsVisible="{Binding IsAnalyticsPage}">
                    <StackPanel Orientation="Horizontal" Spacing="11">
                        <Path Classes="icon" Width="26" Height="26" VerticalAlignment="Center"
                              StrokeThickness="1.6" Stroke="#3B82F6" Data="{StaticResource IconChart}" />
                        <TextBlock Classes="h1" Text="Analytics" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="caption" FontSize="13.5" VerticalAlignment="Center"
                                   Text="Trip stats, stored in and read from your Google Sheet." />
                        <Button Classes="nav" Padding="8,3" Command="{Binding OpenAnalyticsSheetCommand}"
                                IsVisible="{Binding HasAnalyticsSheetLink}">
                            <TextBlock Text="Open the Sheet ↗" FontSize="12.5" />
                        </Button>
                    </StackPanel>

                    <!-- Empty / not-configured / loading state -->
                    <Border Classes="card" IsVisible="{Binding !HasAnalytics}">
                        <TextBlock Classes="caption" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding AnalyticsMessage}" />
                    </Border>

                    <StackPanel Spacing="18" IsVisible="{Binding HasAnalytics}">
                        <!-- Summary tiles -->
                        <Grid ColumnDefinitions="*,*,*">
                            <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Classes="metricLabel" Text="TRIPS" />
                                    <TextBlock Classes="metricValue" Text="{Binding TotalTrips}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="card" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Classes="metricLabel" Text="MAPS" />
                                    <TextBlock Classes="metricValue" Text="{Binding TotalMaps}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="card" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Classes="metricLabel" Text="PLACES" />
                                    <TextBlock Classes="metricValue" Text="{Binding TotalPlaces}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Classes="caption" Text="{Binding AnalyticsThisMonth}" />

                        <!-- Places-per-trip bar chart -->
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="sideHeader" Text="PLACES PER TRIP (RECENT)" />
                                <ItemsControl ItemsSource="{Binding AnalyticsBars}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnalyticsBar">
                                            <Grid ColumnDefinitions="130,*,Auto" Margin="0,0,0,9">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="caption"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,10,0" />
                                                <Border Grid.Column="1" Height="18" CornerRadius="5"
                                                        Background="{StaticResource AccentBrush}"
                                                        Width="{Binding BarWidth}" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ======================== SETTINGS ======================== -->
                <StackPanel Spacing="18" IsVisible="{Binding IsSettingsPage}">
                    <StackPanel Orientation="Horizontal" Spacing="11">
                        <Path Classes="icon" Width="26" Height="26" VerticalAlignment="Center"
                              StrokeThickness="1.6" Stroke="#3B82F6" Data="{StaticResource IconSettings}" />
                        <TextBlock Classes="h1" Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" FontSize="13.5"
                               Text="Saved on this computer, so you only enter them once." />

                    <!-- One-file setup -->
                    <Border Classes="card" BorderBrush="{StaticResource InfoBrush}" Background="#1438BDF8">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Width="17" Height="17" VerticalAlignment="Center" Stroke="{StaticResource InfoBrush}" Data="{StaticResource IconBox}" />
                                <TextBlock Classes="subhead" Text="One-file setup" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="caption"
                                       Text="Drop a single JSON to fill in every setting below — API keys, the service-account JSON, and the Drive credentials.json (written automatically). Any key not in the file keeps its current value." />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Name="SetupBundleButton" Content="Choose setup file…" />
                                <TextBlock Classes="caption" Text="…or drag the .json here" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="caption" Text="{Binding SetupMessage}" Foreground="{StaticResource SuccessBrush}"
                                       IsVisible="{Binding SetupMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subhead" Text="Gemini API key" />
                            <TextBlock Classes="caption"
                                       Text="Used to read the itinerary and extract every place per day." />
                            <Grid>
                                <TextBox Name="GeminiKeyBox" PasswordChar="•" Text="{Binding GoogleApiKey}"
                                         Padding="8,6,40,6" Watermark="AIza…" />
                                <Button Name="GeminiKeyEye" Classes="eye">
                                    <Path Classes="icon" Width="18" Height="18"
                                          Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconEye}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subhead" Text="Places API (New) key" />
                            <TextBlock Classes="caption"
                                       Text="Snaps each place name to its exact Google Maps coordinates via Places API (New) Text Search — enable &quot;Places API (New)&quot; on the key's project. Without it, Gemini's rougher coordinates are used." />
                            <Grid>
                                <TextBox Name="GeoKeyBox" PasswordChar="•" Text="{Binding GeoApiKey}"
                                         Padding="8,6,40,6" Watermark="AIza…" />
                                <Button Name="GeoKeyEye" Classes="eye">
                                    <Path Classes="icon" Width="18" Height="18"
                                          Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconEye}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Service-account JSON (usage gauge) -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subhead" Text="Usage gauge (optional)" />
                            <TextBlock Classes="caption"
                                       Text="Paste the service-account JSON to show the live Places API usage ring — the project is read from it. Needs the Cloud Monitoring API enabled and a service account with roles/monitoring.viewer." />
                            <TextBox AcceptsReturn="True" Height="90" TextWrapping="Wrap"
                                     Text="{Binding GcpSaJson}"
                                     Watermark="Paste the whole service-account .json here" />
                        </StackPanel>
                    </Border>

                    <!-- Analytics Sheet -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subhead" Text="Analytics Sheet (optional)" />
                            <TextBlock Classes="caption"
                                       Text="Logs every generated trip to a Google Sheet the Analytics page reads back. Paste the Sheet ID (or its full URL); share the Sheet as Editor with the service account's email above and enable the Google Sheets API." />
                            <TextBox Text="{Binding AnalyticsSheetId}"
                                     Watermark="Sheet ID, or https://docs.google.com/spreadsheets/d/…" />
                        </StackPanel>
                    </Border>

                    <!-- Drive sharing credentials -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subhead" Text="Drive sharing credentials (optional)" />
                            <TextBlock Classes="caption"
                                       Text="Needed only to share maps. An OAuth Desktop client credentials.json (Drive API enabled), saved locally; a browser consent runs once on first share." />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Name="CredentialsButton" Content="Choose credentials.json…" />
                                <TextBlock Classes="caption" Text="…or drag the .json here" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Setup status -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subhead" Text="Setup status" Margin="0,0,0,4" />
                            <TextBlock>
                                <Run Text="{Binding HasGeminiKey, Converter={x:Static vm:BoolTick.Instance}}" />
                                <Run Text="Gemini API key" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{Binding HasGeoKey, Converter={x:Static vm:BoolTick.Instance}}" />
                                <Run Text="Places API (New) key" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{Binding HasGoogleLogin, Converter={x:Static vm:BoolTick.Instance}}" />
                                <Run Text="Signed in to Google (My Maps)" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{Binding HasDriveCredentials, Converter={x:Static vm:BoolTick.Instance}}" />
                                <Run Text="Drive credentials.json" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{Binding HasDriveToken, Converter={x:Static vm:BoolTick.Instance}}" />
                                <Run Text="Drive access authorized" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- About & updates -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subhead" Text="About &amp; updates" />
                            <TextBlock Classes="caption">
                                <Run Text="My Maps Generator" />
                                <Run Text="{Binding AppVersion}" FontWeight="SemiBold" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Check for updates"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        IsEnabled="{Binding !IsCheckingUpdate}" />
                                <Button Classes="accent" Content="Download &amp; install"
                                        IsVisible="{Binding UpdateAvailable}"
                                        Command="{Binding DownloadAndInstallUpdateCommand}" />
                                <Button Content="Release page"
                                        Command="{Binding OpenReleasePageCommand}" />
                            </StackPanel>
                            <TextBlock Classes="caption" Text="{Binding UpdateStatus}"
                                       IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
